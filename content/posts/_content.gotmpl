{{- /* SOP 发布管线（wayfinder 工单 0008/0009 决议）——seam = 本模板。
       数据源：data/sop.yaml 注册表（发布声明）+ docs/sop 源笔记（纯净正文）。
       构建期派生文章；模板外无生成物、无第二份 .md；ADR-0001 构建命令零改动。

       0.164 语义纪律（CI 钉版；本机 0.167 skew 已坐实）：
       · dates 必须嵌套 dict —— page map 顶层 date 静默失效（工单 0007，
         官方集成测试亦如此写；照抄文档 PortableText 示例会让全部文章日期变零值）。
       · categories/tags 走 params —— 官方 page map 契约，taxonomy 键不得置于顶层。
       · description 放顶层 —— PaperMod 的 head/opengraph 读 .Description，
         放 params 只落 .Params.description，meta 标签会空（实测）。
       · path 相对本适配器所在目录（官方文档原文），故 path = slug 即 /posts/<slug>。
       · range 内用 $.AddPage —— $ 才是持有 AddPage 方法的根上下文。

       输入契约（0008 决议第 4 条，模块内 errorf 执法，构建即门禁）：
       ① 注册条目缺 slug/note/date → 构建失败（标题由笔记 H1 承载，不在注册表）
       ② 条目在而笔记文件缺失（死条目）→ 构建失败
       ③ 笔记首行无 H1 → 构建失败（标题唯一源）
       ④ 笔记 H1 之后无章节标题行 → 构建失败（正文变换的锚点）

       目录契约（0009 决议）：注册表驱动——无条目的笔记 = 尚未发布的稿件，
       容许自然存在；「注册但未发布」= 条目 draft: true（不进生产构建，-D 出现）。

       正文变换（迁移保真，golden 比对坐实的历史规则）：剥 H1 → 保留首个
       章节标题行 → 剥紧随其后的定位段（单行；该段内容由注册表 intro 承载）
       → 正文 = 标题行 + 余部，前置导语。定位段为多行时不被剥（页面可见
       重复，不静默丢失内容）。 */ -}}
{{- $notesDir := site.Params.sopNotesDir | default "docs/sop" -}}
{{- range $entry := hugo.Data.sop -}}
{{- $missing := slice -}}
{{- if not $entry.slug }}{{ $missing = $missing | append "slug" }}{{ end -}}
{{- if not $entry.note }}{{ $missing = $missing | append "note" }}{{ end -}}
{{- if not $entry.date }}{{ $missing = $missing | append "date" }}{{ end -}}
{{- with $missing }}{{ errorf "SOP 发布管线：注册条目缺必填字段 %v（slug/note/date 必填；标题由笔记首行 H1 承载，不在注册表）" . }}{{ end -}}
{{- $raw := "" -}}
{{- with try (os.ReadFile (printf "%s/%s" $notesDir $entry.note)) -}}
  {{- with .Err -}}
    {{- errorf "SOP 发布管线：条目 %s 的源笔记 %s 读取失败：%s" $entry.slug $entry.note . -}}
  {{- else -}}
    {{- $raw = .Value -}}
  {{- end -}}
{{- end -}}
{{- if not (hasPrefix (trim $raw "\n") "# ") }}{{ errorf "SOP 发布管线：源笔记 %s 首行无 H1 标题行（标题唯一源，渲染即失败）" $entry.note }}{{ end -}}
{{- $title := strings.TrimPrefix "# " (index (split (trim $raw "\n") "\n") 0) -}}
{{- $noH1 := replaceRE "(?m)^# [^\n]*\n" "" $raw 1 -}}
{{- $heads := findRE "\\A\\n*[^\\n]*\\n" $noH1 1 -}}
{{- if not $heads }}{{ errorf "SOP 发布管线：源笔记 %s 的 H1 之后无章节标题行（正文变换锚点缺失）" $entry.note }}{{ end -}}
{{- $head := index $heads 0 -}}
{{- $rest := strings.TrimPrefix $head $noH1 -}}
{{- $restNoPara := replaceRE "\\A\\n[^\\n]*\\n\\n" "" $rest 1 -}}
{{- $body := printf "%s\n\n%s" (trim $head "\n") (trim $restNoPara "\n") -}}
{{- $content := printf "%s\n\n---\n\n%s" $entry.intro $body -}}
{{- $.AddPage (dict
      "path" $entry.slug
      "title" $title
      "description" $entry.description
      "draft" $entry.draft
      "dates" (dict "date" ($entry.date | time.AsTime))
      "content" (dict "mediaType" "text/markdown" "value" $content)
      "params" (dict "categories" $entry.categories "tags" $entry.tags)
    ) -}}
{{- end -}}
