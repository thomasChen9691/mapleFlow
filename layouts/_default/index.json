{{- /*
  搜索索引投影（站点层；候选 8「搜索契约」图，工单 0043 决议）
  ============================================================
  本文件是「搜索索引」投影契约的唯一定义处——三层文档契约：
  CONTEXT.md 概念层 / 本 docstring 契约层 / 测试期望值字面量
  （与 ADR-0007 reveal 协议同构）。改投影 = 改本文件 + 同步断言；
  消费方（fastsearch）的接口见 ④。历史：P2-6/P2-7 覆盖主题同名模板，
  「瘦身摘要 + 纳入产品」两条初衷已并入下文契约，不再单列。

  ① 字段表——每条记录恰为六字段：
     title       .Title
     permalink   .Permalink
     summary     .Summary | plainify | htmlUnescape | chomp，再 truncate 200
     content     同一 $summary 再 truncate 320——与 summary 同源、不含正文
                 （既有设计事实；任一侧的变换改变都会改变另一侧）
     tags        .Params.tags | default slice
     categories  .Params.categories | default slice
     字段集冻结为六项（0044 决议）：featured / kind 不投影——无消费方
     （fastsearch keys 不含、结果 UI 不显示）；精选归首页编排（ADR-0009），
     kind 门禁归产品索引链。truncate 200/320 为调值：仅文档不断言。
     summary/content 同源为有意设计（瘦身索引体积，P2-6 初衷），非疏漏。

  ② 排除规则——三类页面不进索引（缺一不可搜索）：
     .Params.searchHidden 为真 / .Layout "archives" / .Layout "search"

  ③ 产品投影——直读 site.Data.products，不过产品索引门禁
     （kind 门禁归属见工单 0045；原 0019 边界注释见下方 with 块内）：
     title = .name；permalink = <产品页 RelPermalink>#<.id>；
     summary = .summary；
     content = printf "%s %s %s" .name .summary (.scale | default "")；
     tags / categories 硬编码 ["产品"]（术语：「产品」；「资源」为禁用词）。
     与产品状态模块的不对称：product-state 的 name 有渲染用缺省值
     "(未命名产品)"，本投影不收缺省——缺 name/summary 即构建失败（见 ⑤）。

  ④ 接口条款——与 themes/maplemod/assets/js/fastsearch.js 的约定
     （该文件即检索交互契约的定义处；2026-10-22 项目级覆盖已合并入主题层，
      单副本由 assert_search_projection 守门）：
     · fetch 路径 "index.json"（同目录相对——站点在子路径 /mapleFlow/ 下，
       上游的 "../index.json" 会逃逸到域名根而 404；head.html preload 同步同目录）；
     · 默认 keys = [title, permalink, summary, content]，即投影六字段
       去掉 tags / categories（扩展检索预留）；
     · 交付面：hugo.toml [outputs] home 含 "JSON"；head.html 仅
       .Layout == "search" 时 preload 本文件；三者任一坏掉，搜索静默
       失效（无报错、无结果）；
     · keys 与投影字段的对齐由 tests/assert_site_contracts.py 的
       assert_search_projection 执法——改投影字段须同步 keys。

  ⑤ 契约执法——投影守自己消费的字段（0043 决议①）：
     · 产品缺 name    → errorf「搜索索引数据：%q 缺少 name 字段（投影必填，无缺省）」
     · 产品缺 summary → errorf「搜索索引数据：%q 缺少 summary 字段（投影必填，无缺省）」
     · listed / price / buy_url / kind 不在此处重验（产品链已有门禁）；
     · 页面 / 派生侧不加投影层执法（如 SOP 注册表缺 intro 的 %!s()
       污染归发布管线契约，ADR-0005）。
*/ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Params.searchHidden) (ne .Layout "archives") (ne .Layout "search") -}}
    {{- $summary := .Summary | plainify | htmlUnescape | chomp -}}
    {{- $index = $index | append (dict
        "title" .Title
        "permalink" .Permalink
        "summary" ($summary | truncate 200)
        "content" ($summary | truncate 320)
        "tags" (.Params.tags | default slice)
        "categories" (.Params.categories | default slice)
    ) -}}
  {{- end -}}
{{- end -}}
{{- with site.GetPage "page" "products" -}}
  {{- $productsPermalink := .RelPermalink -}}
  {{- /* kind 门禁归属（0019 悬置，工单 0045 定案）：此处直读 site.Data.products，
         不经 product-items 的 kind 词汇门禁——门禁归产品索引链（ADR-0006），
         索引不消费 kind（0044：不投影），故无需重复校验。坏 kind 由「产品页恒渲染
         全量 → product-items 恒被调用」触发 errorf，与索引是否存在无关；该隐式
         兜底的牙是 assert_real 的产品页全量断言（tests/assert_site_contracts.py）。 */ -}}
  {{- range site.Data.products -}}
    {{- /* 投影守自己消费的字段（工单 0043 决议①）：name/summary 是投影的
           必填项——product-state 的 name 有渲染用缺省值，但投影不收缺省，
           缺字段即构建失败（消息前缀「搜索索引数据：」，钉子串见测试）。 */ -}}
    {{- if not .name -}}{{ errorf "搜索索引数据：%q 缺少 name 字段（投影必填，无缺省）" .id }}{{- end -}}
    {{- if not .summary -}}{{ errorf "搜索索引数据：%q 缺少 summary 字段（投影必填，无缺省）" .id }}{{- end -}}
    {{- $index = $index | append (dict
        "title" .name
        "permalink" (printf "%s#%s" $productsPermalink .id)
        "summary" .summary
        "content" (printf "%s %s %s" .name .summary (.scale | default ""))
        "tags" (slice "产品")
        "categories" (slice "产品")
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
