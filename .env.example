# ========== 环境变量示例：复制为 .env 并填入实际值 ==========
# 注意：.env 已在 .gitignore 中，不会被提交

# Qwen 大模型 API（可选，用于后续扩展）
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API（可选）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MCP (Model Context Protocol) 相关
MCP_API_KEY=your_mcp_api_key_here
MCP_BASE_URL=https://api.mcp.example.com

# 可选：MCP 鉴权等
# MCP_ACCESS_TOKEN=your_access_token_here
# MCP_SECRET_KEY=your_secret_key_here
